# AURA backend configuration. Copy to .env for local development.
AURA_APP_NAME=AURA Local Companion
AURA_APP_VERSION=0.2.0-phase2
AURA_HOST=127.0.0.1
AURA_PORT=8000
AURA_LOG_LEVEL=INFO
AURA_DATABASE_PATH=backend/data/aura.db
AURA_MODEL_DIR=models/llm
AURA_STT_MODEL_DIR=models/stt
AURA_TTS_MODEL_DIR=models/tts
AURA_LLM_MODEL_PATH=
AURA_LLM_SERVER_URL=http://127.0.0.1:8080
AURA_LLM_CHAT_ENDPOINT=/v1/chat/completions
# Optional name expected by the local llama.cpp server.
AURA_LLM_MODEL_NAME=
# system (default), merge_user (Gemma-style templates), or omit.
AURA_LLM_SYSTEM_PROMPT_MODE=system
AURA_LLM_CONTEXT_SIZE=2048
AURA_LLM_MAX_TOKENS=256
AURA_LLM_TIMEOUT_SECONDS=60
AURA_LLM_TEMPERATURE=0.8
AURA_LLM_TOP_P=0.9
AURA_MAX_HISTORY_MESSAGES=12
AURA_CHARACTER_PROFILE_PATH=character/personality.json
